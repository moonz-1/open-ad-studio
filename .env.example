# Strict release-candidate origin (npm start). Use this same origin for saved projects.
OSH_RC_PORT=8341
# Copy to .env (gitignored). Everything is optional; defaults are local-only.

# Vite port and bind address. 127.0.0.1 = this machine only. Use 0.0.0.0 to share (then set OSH_TOKEN).
OSH_PORT=8310
OSH_HOST=127.0.0.1
# Extra hostnames Vite accepts (e.g. a tunnel domain), comma-separated.
OSH_ALLOWED_HOSTS=
# Required for generation from any non-localhost host. Share links as https://<host>/?token=<OSH_TOKEN>
OSH_TOKEN=

# ComfyUI and the Comfy API v2 proxy (both stay on localhost).
COMFYUI_URL=http://127.0.0.1:8188
# Optional existing ComfyUI folder (main.py plus its .venv, or portable Python).
# COMFYUI_DIR=C:/path/to/ComfyUI
COMFY_BASE_URL=http://127.0.0.1:8189
# Path to the comfy-api-proxy executable if it's not in .venv or on PATH.
COMFY_API_PROXY=
# Optional existing model directory offered by the first-boot setup UI.
COMFYUI_MODELS_DIR=

# Optional path to FFmpeg for MP4 assembly / soundtrack mix; otherwise uses ffmpeg on PATH.
FFMPEG_PATH=
# Optional FFprobe override; otherwise use ffprobe beside FFmpeg or on PATH.
FFPROBE_PATH=

# Optional Brand Intelligence text analysis: preinstalled LOCAL Ollama weights only.
# qwen2.5:7b-instruct or qwen2.5:7b (Apache2). No auto-download/cloud fallback.
ADSTUDIO_BRAND_MODEL=

# Optional Klein FP8 models directory override (defaults to ComfyUI models dir).
# ADSTUDIO_KLEIN_MODELS_DIR=

# Optional FLUX 3: enable only with accepted model terms and a capable backend.
ADSTUDIO_FLUX3_INFERENCE=0
ADSTUDIO_FLUX3_REMOTE_WEIGHTS=0
# Compatibility limitation: 1 bypasses TextGenerate on affected Flash-Attention stacks.
# Dynamics goes straight to CLIP; this is NOT the full prompt-upsampler workflow.
ADSTUDIO_FLUX3_SKIP_PUP=0
ADSTUDIO_FLUX3_MODELS_DIR=
# One-click RunPod FLUX (server-side only). See docs/RUNPOD_ONE_CLICK_FLUX.md
# ADSTUDIO_FLUX3_AUTOPROVISION=0
# ADSTUDIO_RUNPOD_LIVE=0
# ADSTUDIO_FLUX3_SPEND_APPROVED=0
# RUNPOD_API_KEY=
# ADSTUDIO_RUNPOD_PROTECTED_RESERVE_USD=2.96
# ADSTUDIO_RUNPOD_MAX_JOB_USD=0.50
# ADSTUDIO_RUNPOD_MAX_SESSION_USD=0.50
# ADSTUDIO_FLUX3_NETWORK_VOLUME_ID=
# ADSTUDIO_RUNPOD_SSH_KEY=

# Nonbillable customer-action acceptance; overrides both live flags when 1.
# ADSTUDIO_FLUX3_DRY_RUN=1
# Prepared worker must already contain the licensed weights. No automatic download.
# ADSTUDIO_FLUX3_WORKER_IMAGE=registry/name@sha256:<64 lowercase hex>
# ADSTUDIO_FLUX3_WORKER_MODELS_DIR=/opt/ComfyUI/models
# JSON exec-form CMD for the prepared image's private Comfy/SSH startup:
# ADSTUDIO_FLUX3_WORKER_ARGS_JSON=["/start-private-flux"]
# Exact authorized normalized source hash(es), comma-separated; required for cloud upload.
# ADSTUDIO_FLUX3_CLOUD_SOURCE_SHA256=
